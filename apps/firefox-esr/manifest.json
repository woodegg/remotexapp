{
  "apiVersion": "remotexapp/v1",
  "id": "firefox-esr",
  "name": "Firefox ESR",
  "driverVersion": "3.0.1",
  "singleton": true,
  "profileRef": "default",
  "runMode": "shared",
  "ports": {
    "control": {
      "kind": "loopback-tcp",
      "port": 0
    }
  },
  "parameters": {
    "startUrl": {
      "type": "url",
      "default": "about:blank",
      "allowedSchemes": [
        "http",
        "https",
        "about"
      ],
      "maxLength": 2048
    }
  },
  "driver": {
    "config": {
      "protocol": "webdriver-bidi",
      "path": "/session"
    }
  },
  "overrides": {
    "allowed": []
  },
  "dependencies": {
    "executables": [
      "firefox-esr",
      "jq",
      "matchbox-window-manager",
      "python3",
      "sed",
      "seq",
      "sleep",
      "xdotool"
    ],
    "pythonModules": []
  },
  "server": {
    "activation": "on-demand",
    "driver": "server.sh",
    "displayMode": "dynamic",
    "display": 0,
    "rfbPort": 0,
    "gatewayPort": 0,
    "geometry": "1280x720",
    "depth": 16,
    "frameRate": 5,
    "allowClientResize": true,
    "readinessPids": [
      "server.pid"
    ],
    "readinessTimeout": "10s"
  },
  "session": {
    "services": "core-v1",
    "activation": "on-attach",
    "driver": "session.sh",
    "shutdownDriver": "shutdown.sh",
    "readinessPid": "firefox-esr.pid",
    "readinessTimeout": "45s",
    "vacantTimeout": "6h",
    "vacantAction": "stop-instance",
    "status": {
      "mode": "driver",
      "details": {
        "application": {
          "type": "enum",
          "values": [
            "firefox-esr"
          ]
        },
        "control": {
          "type": "json",
          "maxBytes": 8192,
          "maxDepth": 6,
          "maxItems": 64
        }
      }
    }
  },
  "input": {
    "backend": "ibus",
    "lifecycle": "session",
    "allowedWmClasses": [
      "firefox-esr"
    ]
  },
  "actions": {
    "openUrl": {
      "handler": "open-url.py",
      "timeout": "15s",
      "parameters": {
        "url": {
          "type": "url",
          "required": true,
          "allowedSchemes": [
            "http",
            "https"
          ],
          "maxLength": 2048
        },
        "disposition": {
          "type": "enum",
          "values": [
            "new-tab"
          ],
          "default": "new-tab"
        }
      },
      "result": {
        "tabId": {
          "type": "string",
          "required": true,
          "maxLength": 256
        },
        "url": {
          "type": "url",
          "required": true,
          "allowedSchemes": [
            "http",
            "https"
          ],
          "maxLength": 2048
        }
      }
    }
  }
}
