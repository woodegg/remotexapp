{
  "apiVersion": "remotexapp/v1",
  "id": "mousepad",
  "name": "Matchbox + Mousepad",
  "driverVersion": "4.0.1",
  "singleton": false,
  "profileRef": "default",
  "runMode": "isolated",
  "ports": {},
  "parameters": {"filePath": {"type": "file", "maxLength": 4096}},
  "driver": {
    "config": {}
  },
  "overrides": {
    "allowed": ["geometry", "frameRate", "allowClientResize"]
  },
  "dependencies": {
    "executables": ["matchbox-window-manager", "mousepad", "jq", "python3", "sed", "seq", "sleep", "xdotool"],
    "pythonModules": []
  },
  "server": {
    "activation": "on-demand",
    "driver": "server.sh",
    "displayMode": "dynamic",
    "display": 0,
    "rfbPort": 0,
    "gatewayPort": 0,
    "geometry": "1280x720",
    "depth": 16,
    "frameRate": 10,
    "allowClientResize": true,
    "readinessPids": ["server.pid"],
    "readinessTimeout": "10s"
  },
  "session": {
    "services": "core-v1",
    "activation": "immediate",
    "driver": "session.sh",
    "shutdownDriver": "shutdown.sh",
    "readinessPid": "mousepad.pid",
    "readinessTimeout": "20s",
    "vacantTimeout": "60s",
    "vacantAction": "stop-instance",
    "status": {
      "mode": "driver",
      "details": {
        "application": {
          "type": "enum",
          "values": ["mousepad"]
        }
      }
    }
  },
  "input": {
    "backend": "ibus",
    "lifecycle": "session",
    "allowedWmClasses": ["Mousepad", "Org.xfce.mousepad"]
  }
}
