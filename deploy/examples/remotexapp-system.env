# Secure production default: accept identity only from a local reverse proxy.
REMOTEXAPP_LISTEN=127.0.0.1:1991
REMOTEXAPP_AUTH_MODE=trusted-header
REMOTEXAPP_IDENTITY_HEADER=Cf-Access-Authenticated-User-Email
REMOTEXAPP_TRUSTED_PROXIES=127.0.0.0/8,::1/128
REMOTEXAPP_ALLOW_INSECURE_PUBLIC=false
REMOTEXAPP_EXPOSE_INTERNALS=false
REMOTEXAPP_DISABLE_CONSOLE=false
REMOTEXAPP_DISABLE_KIOSK=false
REMOTEXAPP_ENABLE_SERVICE_RESTART=false
# Optional colon-separated absolute roots for file-launch templates.
# REMOTEXAPP_DOCUMENT_ROOTS=/srv/remotexapp-documents

# A real-user override may point to a root-owned per-user class catalog.
REMOTEXAPP_CLASS_CONFIG=/usr/local/share/remotexapp/current/configs/remotexapp-classes
REMOTEXAPP_MAX_INSTANCES=32
REMOTEXAPP_TEXT_LOG=errors

# Host-owned graceful shutdown policy. Zero force-after means never discard
# user work automatically; an authenticated caller may still request force.
REMOTEXAPP_SHUTDOWN_GRACE_TIMEOUT=15s
REMOTEXAPP_SHUTDOWN_BLOCKED_WARNING_AFTER=1h
REMOTEXAPP_SHUTDOWN_FORCE_AFTER=0
