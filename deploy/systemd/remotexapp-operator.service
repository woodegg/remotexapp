[Unit]
Description=RemoteXApp non-root operator helper
Before=remotexapp.service

[Service]
Type=simple
ExecStart=%h/.local/libexec/remotexapp/current/remotexapp-operator-helper \
  -socket %t/remotexapp/operator.sock \
  -unit remotexapp.service
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
