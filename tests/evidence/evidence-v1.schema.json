{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woodegg/remotexapp/tests/evidence/evidence-v1.schema.json",
  "title": "RemoteXApp Evidence V1",
  "type": "object",
  "required": ["schemaVersion", "kind", "runId", "commit", "startedAt", "completedAt", "result", "toolchain", "environment", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "remotexapp/evidence/v1"},
    "kind": {"enum": ["audit", "candidate", "integration", "uat", "publication", "alignment", "security"]},
    "runId": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "result": {"enum": ["completed", "passed", "failed"]},
    "toolchain": {"type": "object"},
    "environment": {"type": "object"},
    "artifact": {"type": "object"},
    "scenarios": {"type": "array", "minItems": 1},
    "details": {"type": "object"}
  },
  "additionalProperties": false
}
