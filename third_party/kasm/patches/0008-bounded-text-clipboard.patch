+// Native text clipboard is bounded before allocation or clipboard mutation.
+// Reject invalid UTF-8 and embedded NUL instead of publishing ambiguous text.
+static bool nativeClipboardUTF8(const unsigned char *p, unsigned n)
+{
+  for (unsigned i = 0; i < n;) {
+    unsigned c = p[i++], need = 0, min = 0;
+    if (c == 0) return false;
+    if (c < 0x80) continue;
+    if (c >= 0xc2 && c <= 0xdf) { need = 1; min = 0x80; c &= 0x1f; }
+    else if (c >= 0xe0 && c <= 0xef) { need = 2; min = 0x800; c &= 0xf; }
+    else if (c >= 0xf0 && c <= 0xf4) { need = 3; min = 0x10000; c &= 7; }
+    else return false;
+    if (need > n - i) return false;
+    while (need--) {
+      unsigned b = p[i++];
+      if ((b & 0xc0) != 0x80) return false;
+      c = (c << 6) | (b & 0x3f);
+    }
+    if (c < min || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff)) return false;
+  }
+  return true;
+}
