+// RemoteXApp native clipboard validation. No allocation or content logging.
+#ifndef REMOTEXAPP_NATIVE_CLIPBOARD_H
+#define REMOTEXAPP_NATIVE_CLIPBOARD_H
+#include <string.h>
+#define NATIVE_CLIPBOARD_LIMIT (2U * 1024U * 1024U)
+static inline int nativeClipboardMime(const char *mime) {
+  if (!strcmp(mime, "text/plain")) return 0;
+  if (!strcmp(mime, "text/html")) return 1;
+  if (!strcmp(mime, "image/png")) return 2;
+  return -1;
+}
+static inline int nativeClipboardAllowed(const char *list, const char *mime) {
+  const size_t n = strlen(mime);
+  while (*list) {
+    const char *end = strchr(list, ',');
+    const size_t size = end ? (size_t)(end - list) : strlen(list);
+    if (size == n && !memcmp(list, mime, n)) return 1;
+    if (!end) break;
+    list = end + 1;
+  }
+  return 0;
+}
+static inline int nativeClipboardUTF8(const unsigned char *p, unsigned n) {
+  unsigned i = 0;
+  while (i < n) {
+    unsigned c = p[i++], need = 0, min = 0;
+    if (!c) return 0;
+    if (c < 0x80) continue;
+    if (c >= 0xc2 && c <= 0xdf) { need = 1; min = 0x80; c &= 0x1f; }
+    else if (c >= 0xe0 && c <= 0xef) { need = 2; min = 0x800; c &= 0xf; }
+    else if (c >= 0xf0 && c <= 0xf4) { need = 3; min = 0x10000; c &= 7; }
+    else return 0;
+    if (need > n - i) return 0;
+    while (need--) {
+      unsigned b = p[i++];
+      if ((b & 0xc0) != 0x80) return 0;
+      c = (c << 6) | (b & 0x3f);
+    }
+    if (c < min || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff)) return 0;
+  }
+  return 1;
+}
+#endif
