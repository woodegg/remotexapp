+// Bounded content-free clipboard ordering on the existing RFB Fence channel.
+#ifndef REMOTEXAPP_NATIVE_CLIPBOARD_ORDER_H
+#define REMOTEXAPP_NATIVE_CLIPBOARD_ORDER_H
+#include <stdint.h>
+#include <string.h>
+struct NativeClipboardFence {
+  char op;
+  uint32_t request;
+  uint64_t revision;
+  static bool owned(const char* data, unsigned len) {
+    return len >= 10 && !memcmp(data, "rx-clip:1:", 10);
+  }
+  static bool parse(const char* data, unsigned len, NativeClipboardFence& out) {
+    if (!owned(data, len) || len != 37 || data[11] != ':' || data[20] != ':') return false;
+    out.op = data[10]; out.request = 0; out.revision = 0;
+    for (unsigned i = 12; i < 37; i++) {
+      if (i == 20) continue;
+      unsigned c = (unsigned char)data[i], digit;
+      if (c >= '0' && c <= '9') digit = c - '0';
+      else if (c >= 'a' && c <= 'f') digit = c - 'a' + 10;
+      else return false;
+      if (i < 20) out.request = (out.request << 4) | digit;
+      else out.revision = (out.revision << 4) | digit;
+    }
+    return true;
+  }
+  static void encode(char op, uint32_t request, uint64_t revision, char data[37]) {
+    memcpy(data, "rx-clip:1:", 10); data[10] = op; data[11] = data[20] = ':';
+    const char* hex = "0123456789abcdef";
+    for (int i = 19; i >= 12; i--) { data[i] = hex[request & 15]; request >>= 4; }
+    for (int i = 36; i >= 21; i--) { data[i] = hex[revision & 15]; revision >>= 4; }
+  }
+};
+struct NativeClipboardAdmission {
+  char status;
+  uint32_t request;
+  NativeClipboardAdmission(char value, uint32_t id) : status(value), request(id) {}
+};
+class NativeClipboardOrder {
+  char mode = 0;
+  uint32_t request = 0, finishing = 0;
+  uint64_t expected = 0;
+public:
+  bool subscribed = false, notificationPending = false;
+  uint64_t notifiedRevision = 0;
+  bool notify(uint64_t revision) {
+    if (!subscribed || notificationPending) return false;
+    notificationPending = true; notifiedRevision = revision; return true;
+  }
+  bool acknowledge(uint64_t revision, uint64_t current) {
+    if (!notificationPending || notifiedRevision != revision) return false;
+    notificationPending = false; return revision != current;
+  }
+  void arm(char value, uint32_t id, uint64_t revision) {
+    // A malformed overlapping client cannot turn an old armed upload into an
+    // unconditional write. State is fixed-size and consumed by the next body.
+    mode = mode || finishing ? 'E' : value; request = id; expected = revision;
+  }
+  void cancel(uint32_t id) { if (mode && request == id) { mode = 0; request = 0; expected = 0; } }
+  NativeClipboardAdmission admit(uint64_t current, bool allowed, bool orderedAllowed = true) {
+    const char active = mode; const uint32_t id = request; const uint64_t revision = expected;
+    mode = 0; request = 0; expected = 0; finishing = 0;
+    if (!active) return NativeClipboardAdmission(allowed ? 'L' : 'E', 0);
+    if (!allowed || !orderedAllowed || !subscribed || !current || active == 'E') return NativeClipboardAdmission('E', id);
+    if (active == 'A' && current != revision) return NativeClipboardAdmission('F', id);
+    finishing = id; return NativeClipboardAdmission('S', id);
+  }
+  uint32_t finish() { uint32_t id = finishing; finishing = 0; return id; }
+};
+#endif
