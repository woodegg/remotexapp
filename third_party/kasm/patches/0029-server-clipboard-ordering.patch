+void VNCServerST::nativeClipboardChanged()
+{
+  // Zero is permanently unavailable after exhaustion; never wrap into ABA.
+  if (clipboardRevision) clipboardRevision = clipboardRevision == ~(rdr::U64)0 ? 0 : clipboardRevision + 1;
