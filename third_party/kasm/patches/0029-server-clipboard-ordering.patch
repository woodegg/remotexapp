+bool VNCSConnectionST::clipboardOrderingAllowed()
+{
+  return (accessRights & AccessCutText) && rfb::Server::acceptCutText &&
+         rfb::Server::sendCutText && state() == RFBSTATE_NORMAL;
+}
+
+void VNCSConnectionST::clipboardOrderReply(char op, rdr::U32 request)
+{
+  char data[37];
+  NativeClipboardFence::encode(op, request, clipboardOrderingAllowed() ? server->nativeClipboardRevision() : 0, data);
+  writer()->writeFence(0, sizeof(data), data);
+}
+
+void VNCSConnectionST::nativeClipboardRevisionChanged()
+{
+  // Revisions advance immediately, but a hostile/fast X11 owner cannot queue
+  // one metadata message per event. One timer coalesces to the latest revision.
+  if (clipboardOrder.subscribed && clipboardOrderingAllowed() && !clipboardOrder.notificationPending && !clipboardOrderTimer.isStarted()) clipboardOrderTimer.start(16);
+}
+
+bool VNCSConnectionST::acceptBinaryClipboard()
+{
+  // All representation validation/staging precedes this admission. No event
+  // loop re-entry occurs between comparison and the subsequent X11 commit.
+  const bool allowed = (accessRights & AccessCutText) && rfb::Server::acceptCutText;
+  const NativeClipboardAdmission result = clipboardOrder.admit(server->nativeClipboardRevision(), allowed, clipboardOrderingAllowed());
+  if (result.status == 'S') clipboardCommitRevision = server->nativeClipboardRevision();
+  if (result.status == 'L' || result.status == 'S') return true;
+  if (result.request) clipboardOrderReply(result.status, result.request);
+  return false;
+}
+
+void VNCSConnectionST::finishBinaryClipboard()
+{
+  const rdr::U32 request = clipboardOrder.finish();
