+// One bounded incremental clipboard transaction per authenticated connection.
+#ifndef REMOTEXAPP_NATIVE_CLIPBOARD_READ_H
+#define REMOTEXAPP_NATIVE_CLIPBOARD_READ_H
+#include <chrono>
+#include <vector>
+struct NativeClipboardRead {
+  using Clock = std::chrono::steady_clock;
+  bool active = false;
+  unsigned phase = 0, count = 0, index = 0, mimeLength = 0;
+  unsigned total = 0, seen = 0, offset = 0;
+  char mimes[3][32] = {};
+  std::vector<unsigned char> data[3];
+  Clock::time_point started;
+  void begin() { if (!active) { active = true; started = Clock::now(); } }
+  unsigned remainingMs() const {
+    if (!active) return 0;
+    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - started).count();
+    return elapsed >= 50000 ? 0 : 50000 - (unsigned)elapsed;
+  }
+  void reset() { *this = NativeClipboardRead(); }
+};
+#endif
