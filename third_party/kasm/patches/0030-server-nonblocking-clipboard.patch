+// Stage incrementally without blocking the shared X11 event loop. Never expose
+// partial data; validate the complete bounded transaction before admission.
+bool SMsgReader::readBinaryClipboard()
+{
+  NativeClipboardRead& tx = clipboardRead;
+  tx.begin();
+  for (;;) {
+    if (!tx.remainingMs()) throw Exception("Native clipboard transfer timed out");
+    if (tx.phase == 0) {
+      if (!is->checkNoWait(1)) return false;
+      tx.count = is->readU8();
+      if (!tx.count || tx.count > 3) throw Exception("Invalid native clipboard count");
+      tx.phase = 1;
+    }
+    if (tx.phase == 1) {
+      if (!is->checkNoWait(1)) return false;
+      tx.mimeLength = is->readU8();
+      if (tx.mimeLength < 9 || tx.mimeLength > 10) throw Exception("Invalid native clipboard MIME");
+      tx.phase = 2;
+    }
+    if (tx.phase == 2) {
+      if (!is->checkNoWait(tx.mimeLength)) return false;
+      char* mime = tx.mimes[tx.index];
+      is->readBytes(mime, tx.mimeLength);
+      const int type = nativeClipboardMime(mime);
+      if (strlen(mime) != tx.mimeLength || type < 0 || (tx.seen & (1U << type)) || !nativeClipboardAllowed(rfb::Server::DLP_Clip_Types, mime))
+        throw Exception("Unsupported native clipboard MIME");
+      tx.seen |= 1U << type;
+      tx.phase = 3;
+    }
+    if (tx.phase == 3) {
+      if (!is->checkNoWait(4)) return false;
+      const rdr::U32 length = is->readU32();
+      if (length > NATIVE_CLIPBOARD_LIMIT - tx.total) throw Exception("Native clipboard exceeds byte limit");
+      tx.total += length;
+      if (rfb::Server::DLP_ClipAcceptMax && tx.total > (unsigned)rfb::Server::DLP_ClipAcceptMax)
+        throw Exception("Native clipboard exceeds byte limit");
+      tx.data[tx.index].resize(length); tx.offset = 0; tx.phase = 4;
+    }
+    if (tx.phase == 4) {
+      auto& data = tx.data[tx.index];
+      while (tx.offset < data.size()) {
+        if (!tx.remainingMs()) throw Exception("Native clipboard transfer timed out");
+        if (!is->checkNoWait(1)) return false;
+        const size_t size = std::min(data.size() - tx.offset, is->avail());
+        is->readBytes(data.data() + tx.offset, size); tx.offset += size;
+      }
+      if (nativeClipboardMime(tx.mimes[tx.index]) != 2 && !nativeClipboardUTF8(data.data(), data.size()))
+        throw Exception("Native clipboard is not valid UTF-8 text");
+      if (++tx.index < tx.count) { tx.phase = 1; continue; }
+      if (!tx.remainingMs()) throw Exception("Native clipboard transfer timed out");
+      // Policy may have changed while an incomplete body yielded to X11.
+      if (rfb::Server::DLP_ClipAcceptMax && tx.total > (unsigned)rfb::Server::DLP_ClipAcceptMax)
+        throw Exception("Native clipboard exceeds current byte limit");
+      for (unsigned i = 0; i < tx.count; i++)
+        if (!nativeClipboardAllowed(rfb::Server::DLP_Clip_Types, tx.mimes[i]))
+          throw Exception("Native clipboard MIME no longer allowed");
+      // No event-loop re-entry between this revision comparison and commit.
+      if (handler->acceptBinaryClipboard()) {
+        handler->clearBinaryClipboard();
+        for (unsigned i = 0; i < tx.count; i++)
+          handler->addBinaryClipboard(tx.mimes[i], tx.data[i].data(), tx.data[i].size(), 0);
+        handler->handleClipboardAnnounceBinary(tx.count, tx.mimes);
+        handler->finishBinaryClipboard();
+      }
+      tx.reset();
+      return true;
+    }
+  }
 }
 
